{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Ares (manual)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/n64-demo.elf",
      "cwd": "${workspaceFolder}",
      "miDebuggerPath": "${workspaceFolder}/debug-gdb.sh",
      "miDebuggerServerAddress": "localhost:2159",
      "MIMode": "gdb",
      "externalConsole": false,
      "stopAtEntry": false,
      "sourceFileMap": {
        "/": "${workspaceFolder}/",
        "/home/deck/n64_test_project": "${workspaceFolder}"
      },
      "setupCommands": [
        { "text": "set architecture mips:4000" },
        { "text": "set endian big" },
        { "text": "set mips mask-address off" },
        { "text": "set auto-solib-add off" },
        { "text": "set stop-on-solib-events 0" },
        { "text": "set substitute-path / ${workspaceFolder}" },
        { "text": "set substitute-path /home/deck/n64_test_project ${workspaceFolder}" },
        { "text": "directory ${workspaceFolder}" },
        { "text": "file ${workspaceFolder}/build/n64-demo.elf" }
      ]
    }
  ]
}
